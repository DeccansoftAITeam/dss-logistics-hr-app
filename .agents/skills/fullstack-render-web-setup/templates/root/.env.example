# Client-facing web config
#
# RULES:
#  1. Every key here must be safe to expose in the browser.
#     Backend secrets (DATABASE_URL, API keys, etc.) belong in backend/.env or Render environment secrets.
#  2. Validated via packages/env.

VITE_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

VITE_APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
