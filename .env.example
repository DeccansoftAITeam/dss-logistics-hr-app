# DSS Ask Policy — environment template.
# Copy to .env (backend) / .env.local (apps/web) and fill in real values.
# NEVER commit real keys. See DEPLOY.md for where each value comes from.

# ---------- Backend (backend/.env) ----------
APP_ENV=development

# PostgreSQL (Render managed DB adds sslmode — handled by config.py)
DATABASE_URL=postgresql://user:password@host:5432/ask_policy

# First sign-in with this email is auto-promoted to verified Admin (one-click deploys)
ADMIN_BOOTSTRAP_EMAIL=

# Clerk (https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ORG_ID=

# Azure OpenAI (optional — omit to run in demo mode)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Azure Blob Storage (optional — ingestion skips upload when absent)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=dss-ask-policy-content

# Jira Cloud escalations (optional — synthetic ticket keys without these)
JIRA_SITE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=HRSD

PERMISSION_CACHE_TTL_SECONDS=300

# ---------- Web (apps/web/.env.local) ----------
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...
# CLERK_ORG_ID=org_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# INTERNAL_BACKEND_URL=http://127.0.0.1:8000